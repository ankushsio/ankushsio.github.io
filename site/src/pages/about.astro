---
import Base from "../layouts/Base.astro";
import career from "../data/career.json";
import CareerTimeline from "../components/CareerTimeline.astro";

const company = career.companies[0];
const prior = career.prior_experience;
const education = career.education;
---

<Base
  title="Path"
  description="Ankush Jain's career path — five years of backend engineering across clinical research, medical devices, imaging and video infrastructure."
  path="/about"
>
  <section class="section">
    <div class="sec-head">
      <h2>Path</h2>
      <span class="fill"></span>
      <span class="mono">2021 — present</span>
    </div>

    <p class="lede measure">
      {career.person.summary}
    </p>
  </section>

  <section class="section">
    <div class="sec-head">
      <h2>Three years at {company.name}, drawn out</h2>
      <span class="fill"></span>
    </div>
    <CareerTimeline />
  </section>

  <section class="section">
    <div class="sec-head">
      <h2>Beyond the projects</h2>
      <span class="fill"></span>
    </div>
    <ul class="bullets measure">
      {company.cross_project_highlights.map((h) => <li>{h.text}</li>)}
    </ul>
  </section>

  <section class="section">
    <div class="sec-head">
      <h2>Before {company.name}</h2>
      <span class="fill"></span>
      <span class="mono">2019 — 2023</span>
    </div>

    <p class="measure arc">{career.positioning.arc}</p>

    {
      prior.full_time.map((job) => (
        <article class="past">
          <div class="past-head">
            <h3>{job.company}</h3>
            <span class="mono">{job.role} · {job.dates} · {job.location}</span>
          </div>
          {job.summary && <p class="measure summary">{job.summary}</p>}
          <ul class="bullets measure">
            {job.highlights.map((h) => (
              <li>{h.text}</li>
            ))}
          </ul>
        </article>
      ))
    }

    {
      prior.internships.length > 0 && (
        <article class="past">
          <div class="past-head">
            <h3>Internships</h3>
            <span class="mono">2019 — 2021</span>
          </div>
          <dl class="interns">
            {prior.internships.map((job) => (
              <div>
                <dt>
                  {job.role}, {job.company}
                  <span class="mono when">{job.dates}</span>
                  {job.summary && <span class="mono field">{job.summary}</span>}
                </dt>
                {job.highlights.map((h) => (
                  <dd>{h.text}</dd>
                ))}
              </div>
            ))}
          </dl>
        </article>
      )
    }
  </section>

  <section class="section">
    <div class="sec-head">
      <h2>Education &amp; achievements</h2>
      <span class="fill"></span>
    </div>
    {
      education.map((e) => (
        <div class="past-head">
          <h3>{e.institution}</h3>
          <span class="mono">{e.degree} · {e.dates}</span>
        </div>
      ))
    }
    <ul class="bullets measure achievements">
      {
        career.achievements.map((a) => (
          <li>
            {a.text} <span class="mono when">{a.year}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="sec-head">
      <h2>How I work</h2>
      <span class="fill"></span>
    </div>
    <div class="measure">
      <p>
        I like problems where the constraint is real — a licence that expires, a frame
        budget that will not stretch, a record that must only be visible to the right
        person. Those force a decision rather than a preference, and the decision is
        usually the interesting part.
      </p>
      <p>
        Most of my work has been in regulated or safety-adjacent domains, which has made
        me careful in a specific way: I would rather flesh out the end-to-end scope of a
        change and name its risks up front than discover them halfway through. That is a
        lesson learned the hard way on an access-control project that was scoped
        optimistically and had to be reshaped mid-flight.
      </p>
      <p>
        I also spend real time on the things around the code — onboarding people onto
        projects, reviewing designs rather than only diffs, and making setup simple enough
        that a new developer needs the source and nothing else.
      </p>
    </div>
  </section>
</Base>

<style>
  .lede {
    font-size: clamp(1.06rem, 2vw, 1.22rem);
    color: var(--muted);
    margin: 0;
  }
  .arc {
    margin: 0 0 30px;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .past {
    padding: 0 0 26px;
  }
  .past + .past {
    border-top: 1px solid var(--rule-soft);
    padding-top: 24px;
  }
  .past-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .past-head h3 {
    font-size: 1.28rem;
    font-weight: 600;
    margin: 0;
  }
  .summary {
    color: var(--muted);
    font-style: italic;
    margin: 0 0 12px;
  }

  .interns > div {
    padding: 10px 0;
    border-bottom: 1px dotted var(--rule);
  }
  .interns > div:last-child {
    border-bottom: 0;
  }
  .interns dt {
    font-weight: 600;
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .interns dd {
    margin: 4px 0 0;
    color: var(--muted);
    max-width: var(--measure);
  }
  .when {
    font-weight: 400;
  }
  .field {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .achievements {
    margin-top: 18px;
  }
  .measure p {
    margin: 0 0 18px;
  }
  .measure p:last-child {
    margin-bottom: 0;
  }
</style>
