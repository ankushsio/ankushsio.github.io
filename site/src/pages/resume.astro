---
import Base from "../layouts/Base.astro";
import career from "../data/career.json";
import { periodLong } from "../lib/dates";

const person = career.person;
const company = career.companies[0];
const prior = career.prior_experience;
const hasPrior = prior.full_time.length > 0 || prior.internships.length > 0;
const education = career.education;

/**
 * The web résumé shows EVERY highlight, metric-bearing ones first.
 *
 * The one-page PDF is the constrained artifact; this page has unlimited room, so it must
 * never show less than the PDF does. It previously capped at three bullets per project,
 * which made the page with more space carry less detail than the page with none.
 */
const bulletsFor = (p: (typeof company.projects)[number]) => [
  ...p.highlights.filter((h) => h.metric),
  ...p.highlights.filter((h) => !h.metric),
];

const projects = [...company.projects].sort(
  (a, b) => (b.hours ?? 0) - (a.hours ?? 0)
);

const skillGroups: [string, string[]][] = [
  ["Languages", career.skills.languages],
  ["Backend & messaging", career.skills.backend],
  ["Databases", career.skills.databases],
  ["Cloud & DevOps", career.skills.cloud_devops],
  ["Healthcare & standards", career.skills.domain],
  ["Security", career.skills.security],
  ["ML & imaging", career.skills.ml_imaging],
  ["Practices", career.skills.practices],
];

const fmt = periodLong;
---

<Base
  title="Résumé"
  description="Ankush Jain's résumé — backend engineer, five years across clinical research platforms, medical devices, imaging and video infrastructure."
  path="/resume"
>
  <section class="section">
    <div class="sec-head">
      <h2>Résumé</h2>
      <span class="fill"></span>
      <span class="mono">Updated {career.meta.last_updated}</span>
    </div>

    <p class="lede measure">{person.summary}</p>

    <p class="contact">
      <a href={`mailto:${person.email}`}>{person.email}</a>
      <span class="sep">·</span>
      <a href={person.links.linkedin} rel="noopener">LinkedIn</a>
      <span class="sep">·</span>
      <a href={person.links.github} rel="noopener">GitHub</a>
      <span class="sep">·</span>
      <span class="where">{person.location}</span>
    </p>

    <p class="dl mono">
      <a href="/ankush-jain-resume.pdf">Download the one-page PDF →</a>
    </p>
    <p class="note measure">
      This page is the long version — every project, every highlight. The PDF is cut to one
      page for applications.
    </p>
  </section>

  <section class="section">
    <div class="sec-head"><h2>Experience</h2><span class="fill"></span></div>

    <div class="job">
      <div class="job-head">
        <h3>{company.name}</h3>
        <span class="mono">May 2023 — present</span>
      </div>
      <ul class="roles">
        {
          (company.roles ?? [{ title: company.role, dates: "" }]).map((r) => (
            <li>
              <span class="role-title">{r.title}</span>
              <span class="mono">{r.dates}</span>
            </li>
          ))
        }
      </ul>
      <p class="measure job-note">{company.context}</p>

      {
        projects.map((p) => (
          <div class="proj">
            <h4>
              <a href={`/work/${p.slug}`}>{p.title}</a>
              <span class="mono when">{fmt(p.period)} · {p.domain}</span>
            </h4>
            <ul class="bullets measure">
              {bulletsFor(p).map((h) => (
                <li>{h.text}</li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="proj">
        <h4>Across projects</h4>
        <ul class="bullets measure">
          {company.cross_project_highlights.map((h) => <li>{h.text}</li>)}
        </ul>
      </div>
    </div>

    {
      !hasPrior && (
        <div class="job pending">
          <div class="job-head">
            <h3>Earlier roles</h3>
            <span class="mono">2021 — 2023</span>
          </div>
          <p class="measure job-note">
            Two engineering roles and three internships between graduating in 2021 and
            joining {company.name}. Being written up.
          </p>
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="sec-head"><h2>Skills</h2><span class="fill"></span></div>
    <dl class="skills">
      {
        skillGroups.map(([label, items]) => (
          <div>
            <dt class="mono">{label}</dt>
            <dd>{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <div class="sec-head"><h2>Education</h2><span class="fill"></span></div>
    {
      education.map((e) => (
        <div class="job-head edu">
          <h3>{e.institution}</h3>
          <span class="mono">{e.degree} · {e.dates}</span>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .lede {
    font-size: clamp(1.04rem, 2vw, 1.2rem);
    color: var(--muted);
    margin: 0 0 22px;
  }
  .contact {
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: baseline;
  }
  .contact .sep {
    color: var(--muted);
  }
  .contact .where {
    color: var(--muted);
  }

  .dl {
    margin: 0 0 8px;
  }
  .note {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }

  /* Same affordance as the work pages: a link has to look like one before hover. */
  .proj h4 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .proj h4 a::after {
    content: "→";
    color: var(--accent);
    font-size: 0.8em;
    display: inline-block;
    margin-left: 0.3em;
    transition: transform 0.18s ease;
  }
  .proj h4 a:hover,
  .proj h4 a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .proj h4 a:hover::after {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .proj h4 a::after {
      transition: none;
    }
  }

  .edu {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .job {
    margin-bottom: 34px;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
  .job-head h3 {
    font-size: 1.32rem;
    font-weight: 600;
    margin: 0;
  }
  .roles {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
  }
  .roles li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 3px 0;
  }
  .role-title {
    font-style: italic;
  }
  /* The current title reads at full strength; the one before it steps back. */
  .roles li + li .role-title {
    color: var(--muted);
  }

  .job-note {
    color: var(--muted);
    margin: 0 0 22px;
  }
  .pending .job-note {
    font-style: italic;
  }

  .proj {
    margin-bottom: 22px;
  }
  .proj h4 {
    font-size: 1.06rem;
    font-weight: 600;
    margin: 0 0 8px;
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .when {
    font-weight: 400;
  }

  .skills > div {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px dotted var(--rule);
  }
  .skills > div:last-child {
    border-bottom: 0;
  }
  .skills dt {
    padding-top: 3px;
  }
  .skills dd {
    margin: 0;
  }

  @media (max-width: 700px) {
    .skills > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
