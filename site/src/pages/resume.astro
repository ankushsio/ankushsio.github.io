---
import Base from "../layouts/Base.astro";
import career from "../data/career.json";
import { periodLong } from "../lib/dates";

const person = career.person;
const company = career.companies[0];
const prior = career.prior_experience;
const education = career.education;

/**
 * The web résumé shows EVERY highlight — metric-bearing ones lifted into a results
 * callout, the rest as plain bullets underneath.
 *
 * The one-page PDF is the constrained artifact; this page has unlimited room, so it must
 * never show less than the PDF does. It previously capped at three bullets per project,
 * which made the page with more space carry less detail than the page with none. The
 * split below reorders and re-styles; it never drops anything.
 */
const metricsFor = (p: (typeof company.projects)[number]) =>
  p.highlights.filter((h) => h.metric);
const restFor = (p: (typeof company.projects)[number]) =>
  p.highlights.filter((h) => !h.metric);

const projects = [...company.projects].sort(
  (a, b) => (b.hours ?? 0) - (a.hours ?? 0)
);

/**
 * Every project, prior role and internship carries a `tech` list except the Directi
 * internship, which has none in the record. Render nothing there rather than invent one.
 */
const techOf = (entry: { tech?: string[] }) => (entry.tech ?? []).slice(0, 9);

const skillGroups: [string, string[]][] = [
  ["Languages", career.skills.languages],
  ["Backend & messaging", career.skills.backend],
  ["Databases", career.skills.databases],
  ["Cloud & DevOps", career.skills.cloud_devops],
  ["Standards & integration", career.skills.domain],
  ["Security", career.skills.security],
  ["ML & imaging", career.skills.ml_imaging],
  ["Practices", career.skills.practices],
];

const fmt = periodLong;
---

<Base
  title="Résumé"
  description={`${career.person.name}'s résumé — ${career.positioning.level}, five years on ${career.positioning.descriptor}.`}
  path="/resume"
>
  <section class="section">
    <div class="sec-head">
      <h1>Résumé</h1>
      <span class="fill"></span>
      <span class="mono">Updated {career.meta.last_updated}</span>
    </div>

    <p class="lede measure">{person.summary}</p>

    <p class="contact">
      <a href={`mailto:${person.email}`}>{person.email}</a>
      <span class="sep">·</span>
      <a href={person.links.linkedin} rel="noopener">LinkedIn</a>
      <span class="sep">·</span>
      <a href={person.links.github} rel="noopener">GitHub</a>
      <span class="sep">·</span>
      <span class="where">{person.location}</span>
    </p>

    <p class="dl mono">
      <a href="/ankush-jain-resume.pdf">Download the one-page PDF →</a>
    </p>
    <p class="note measure">
      This page is the long version — every project, every highlight. The PDF is cut to one
      page.
    </p>
  </section>

  <section class="section">
    <div class="sec-head"><h2>Experience</h2><span class="fill"></span></div>

    <div class="job">
      <div class="job-head">
        <h3>{company.name}</h3>
        <span class="mono">May 2023 — present</span>
      </div>
      <ul class="roles">
        {
          (company.roles ?? [{ title: company.role, dates: "" }]).map((r) => (
            <li>
              <span class="role-title">{r.title}</span>
              <span class="mono">{r.dates}</span>
            </li>
          ))
        }
      </ul>
      <p class="measure job-note">{company.context}</p>

      {
        projects.map((p) => (
          <div class="proj row">
            {/* Period, domain and stack all live in the rail so every project block
                aligns on the same spine, the way the /work index does — and so the
                column beside a long bullet list is not simply empty. Hours order the
                list but are deliberately never shown — see CareerTimeline.astro. */}
            <div class="rail">
              <div class="mono">{fmt(p.period)}</div>
              <div class="mono">{p.domain}</div>
              <ul class="stack">
                {techOf(p).map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="pbody">
              <h4>
                <a href={`/work/${p.slug}`}>{p.title}</a>
              </h4>
              {metricsFor(p).length > 0 && (
                <ul class="results">
                  {metricsFor(p).map((h) => (
                    <li>{h.text}</li>
                  ))}
                </ul>
              )}
              {restFor(p).length > 0 && (
                <ul class="bullets measure">
                  {restFor(p).map((h) => (
                    <li>{h.text}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))
      }

      <div class="proj row">
        <div class="rail"></div>
        <div class="pbody">
          <h4>Across projects</h4>
          <ul class="bullets measure">
            {company.cross_project_highlights.map((h) => <li>{h.text}</li>)}
          </ul>
        </div>
      </div>
    </div>

    {
      prior.full_time.map((job) => (
        <div class="job">
          <div class="job-head">
            <h3>{job.company}</h3>
            <span class="mono">{job.dates}</span>
          </div>
          <ul class="roles">
            <li>
              <span class="role-title">{job.role}</span>
              <span class="mono">{job.location}</span>
            </li>
          </ul>
          {job.summary && <p class="measure job-note">{job.summary}</p>}
          {/* The dates and location already sit in the head above, so the rail carries
              just the stack — on the same spine as every project. */}
          <div class="row">
            <div class="rail">
              {techOf(job).length > 0 && (
                <ul class="stack">
                  {techOf(job).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </div>
            <div class="pbody">
              <ul class="bullets measure">
                {job.highlights.map((h) => (
                  <li>{h.text}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }

    {
      prior.internships.length > 0 && (
        <div class="job interns">
          <div class="job-head">
            <h3>Internships</h3>
            <span class="mono">2019 — 2021</span>
          </div>
          {prior.internships.map((job) => (
            <div class="proj row">
              <div class="rail">
                <div class="mono">{job.dates}</div>
                {techOf(job).length > 0 && (
                  <ul class="stack">
                    {techOf(job).map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="pbody">
                <h4>
                  {job.role}, {job.company}
                </h4>
                {/* The summary describes the problem space; highlights claim work done in
                    it. An internship can legitimately have the first without the second,
                    so render the summary rather than leaving an empty bullet list. */}
                {job.summary && <p class="measure intern-summary">{job.summary}</p>}
                {job.highlights.length > 0 && (
                  <ul class="bullets measure">
                    {job.highlights.map((h) => (
                      <li>{h.text}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="sec-head"><h2>Skills</h2><span class="fill"></span></div>
    <dl class="skills">
      {
        skillGroups.map(([label, items]) => (
          <div>
            <dt class="mono">{label}</dt>
            <dd>{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Two short sections side by side rather than two more full-width bands — it closes
      the page on a different layout instead of a ninth stack of bullets. */}
  <section class="section two-up">
    {
      career.achievements.length > 0 && (
        <div>
          <div class="sec-head">
            <h2>Achievements</h2>
            <span class="fill" />
          </div>
          <ul class="bullets">
            {career.achievements.map((a) => (
              <li>
                {a.text} <span class="mono year">{a.year}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div>
      <div class="sec-head"><h2>Education</h2><span class="fill"></span></div>
      {
        education.map((e) => (
          <div class="job-head edu">
            <h3>{e.institution}</h3>
            <span class="mono">{e.degree} · {e.dates}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .lede {
    font-size: clamp(1.04rem, 2vw, 1.2rem);
    color: var(--muted);
    margin: 0 0 22px;
  }
  .contact {
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: baseline;
  }
  .contact .sep {
    color: var(--muted);
  }
  .contact .where {
    color: var(--muted);
  }

  .dl {
    margin: 0 0 8px;
  }
  .note {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }

  /* --- the spine ------------------------------------------------------ */

  /* Same two-column measure as the /work index, so a reader moving between the two
     pages sees one layout rather than two — a little wider here, because this rail
     carries the stack as well as the dates. */
  .row {
    display: grid;
    grid-template-columns: 176px 1fr;
    gap: 30px;
  }
  .rail {
    padding-top: 7px;
  }
  .rail div + div {
    margin-top: 6px;
  }
  /* Stacked rather than a band under the bullets: it fills a column that would
     otherwise sit empty beside eleven bullets, and costs the page no height. */
  .rail .stack {
    margin-top: 14px;
    gap: 5px;
  }
  .rail .stack li {
    max-width: 100%;
  }
  /* A rail carrying only a stack has no dates above it to clear. */
  .rail .stack:first-child {
    margin-top: 0;
  }

  /* --- measured results ------------------------------------------------ */

  /* The .result treatment from global.css, widened to hold a project's several
     metrics in one callout instead of several stacked boxes. */
  .results {
    list-style: none;
    margin: 0 0 15px;
    padding: 11px 16px;
    border-left: 2px solid var(--gain);
    background: var(--gain-wash);
    max-width: var(--measure);
  }
  .results li {
    color: var(--gain);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .results li + li {
    margin-top: 9px;
  }

  /* Same affordance as the work pages: a link has to look like one before hover. */
  .proj h4 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .proj h4 a::after {
    content: "→";
    color: var(--accent);
    font-size: 0.8em;
    display: inline-block;
    margin-left: 0.3em;
    transition: transform 0.18s ease;
  }
  .proj h4 a:hover,
  .proj h4 a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .proj h4 a:hover::after {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .proj h4 a::after {
      transition: none;
    }
  }

  .edu {
    border-bottom: 0;
    margin-bottom: 0;
  }
  /* The company scale is too wide for a half-width column. */
  .edu h3 {
    font-size: 1.24rem;
  }

  .year {
    margin-left: 6px;
  }

  .job {
    margin-bottom: 40px;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
  .job-head h3 {
    font-size: 1.7rem;
    font-weight: 600;
    margin: 0;
  }
  .roles {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
  }
  .roles li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 3px 0;
  }
  .role-title {
    font-style: italic;
  }
  /* The current title reads at full strength; the one before it steps back. */
  .roles li + li .role-title {
    color: var(--muted);
  }

  .job-note {
    color: var(--muted);
    margin: 0 0 16px;
  }
  .pending .job-note {
    font-style: italic;
  }

  /* More air between projects than within one, so each block reads as a block. */
  .proj {
    border-top: 1px solid var(--rule-soft);
    padding-top: 20px;
    margin-bottom: 32px;
  }
  /* Bullets sit closer together than blocks do, so proximity does the grouping. */
  .bullets li {
    margin-bottom: 7px;
  }
  .proj:last-child {
    margin-bottom: 0;
  }
  .proj h4 {
    font-size: 1.28rem;
    font-weight: 600;
    margin: 0 0 12px;
  }

  /* Three entries of one line each, from six and seven years ago. They get the same
     structure as a project at a smaller scale, so they read as the tail of the record
     rather than a fourth job competing with it. */
  .interns {
    margin-bottom: 0;
  }
  .interns .proj {
    padding-top: 13px;
    margin-bottom: 14px;
  }
  .interns .proj h4 {
    font-size: 1.06rem;
    margin-bottom: 4px;
  }
  .interns .intern-summary {
    margin: 0;
  }
  .interns .bullets {
    margin-top: 5px;
  }
  .interns .bullets li {
    margin-bottom: 4px;
  }
  .interns .rail {
    padding-top: 4px;
  }
  .interns .rail .stack {
    margin-top: 8px;
  }

  .skills > div {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px dotted var(--rule);
  }
  .skills > div:last-child {
    border-bottom: 0;
  }
  .skills dt {
    padding-top: 3px;
  }
  .skills dd {
    margin: 0;
  }

  /* Page-local: five sections at the global 58px rhythm is a lot of air on the one
     page that is already the longest on the site. */
  .section {
    padding: 46px 0;
  }

  .two-up {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  @media (max-width: 700px) {
    .skills > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    /* Collapsed, the rail's contents have to split around the body: the dates read as
       a kicker above the title, but a stack of nine chips before the reader knows which
       project they belong to does not. Dissolving the rail promotes its children to
       flex items so they can be ordered independently — and an empty rail then
       contributes nothing, instead of an extra gap. */
    .row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .rail {
      display: contents;
    }
    .rail > .mono {
      order: 1;
      margin-top: 0;
    }
    .pbody {
      order: 2;
    }
    .rail > .stack {
      order: 3;
      margin-top: 0;
    }
    .two-up {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .intern-summary {
    color: var(--muted);
    margin: 4px 0 0;
  }
</style>
